{
  "name": "markdown-mermaid-studio",
  "version": "0.5.1",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "next build",
    "postinstall": "patch-package",
    "start": "next start",
    "test": "npm run lint && npm run test:unit && npm run build:pages && npm run test:pages",
    "test:unit": "node --import tsx --test tests/*.test.ts tests/*.test.tsx",
    "test:pages": "node --test tests/pages-smoke.test.mjs",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern out"
  },
  "dependencies": {
    "katex": "^0.18.1",
    "lucide-react": "^1.29.0",
    "mermaid": "^11.17.0",
    "next": "^16.3.0",
    "patch-package": "^8.0.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.10",
    "typescript": "5.9.3"
  },
  "type": "module",
  "displayName": "Markdown Mermaid Studio"
}
